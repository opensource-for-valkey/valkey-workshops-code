# Source FAQ corpus. The default resolves to ../data from this demo folder.
SEMANTIC_FAQ_DATA_DIR=../data

# Valkey Bundle provides the Search module used by the HNSW index.
SEMANTIC_FAQ_VALKEY_URL=valkey://localhost:16379/0

# Stable FAQ answers can use a longer TTL than weather or real-time data.
SEMANTIC_FAQ_CACHE_TTL_SECONDS=3600

# Cosine-similarity gate for reusing a previously cached answer.
SEMANTIC_FAQ_CACHE_SIMILARITY_THRESHOLD=0.88

# Minimum similarity for selecting an answer from the source FAQ corpus.
SEMANTIC_FAQ_RETRIEVAL_THRESHOLD=0.45

SEMANTIC_FAQ_SEARCH_CANDIDATES=10
SEMANTIC_FAQ_EMBEDDING_MODEL=all-MiniLM-L6-v2

# DELETE /cache is disabled unless this is explicitly enabled.
SEMANTIC_FAQ_CACHE_ALLOW_CLEAR=false
