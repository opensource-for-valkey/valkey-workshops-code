# Database Configuration
# Supported: mysql, mariadb, postgresql
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=flughafen_user
DB_PASSWORD=replace-with-workshop-password
DB_NAME=flughafendb_large

# Cache Configuration
# Supported: redis, valkey, memcached
CACHE_ENGINE=valkey
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_USERNAME=
CACHE_PASSWORD=
CACHE_DB=0
CACHE_TTL=3600

# Cache transport safety and health checks
CACHE_TLS=false
CACHE_TLS_CA_CERTS=
CACHE_TLS_CERTFILE=
CACHE_TLS_KEYFILE=
CACHE_CONNECT_TIMEOUT=5
CACHE_SOCKET_TIMEOUT=5
CACHE_HEALTH_CHECK_INTERVAL=30

# Destructive cache clearing is disabled by default. Enable this only when the
# configured cache is isolated for local workshop use.
CACHE_ALLOW_FLUSH_ALL=false

# Failed write-behind tasks are retried this many times before dead-lettering.
WRITE_BEHIND_MAX_RETRIES=3

# Ollama Configuration
OLLAMA_MODEL=codellama
OLLAMA_URL=http://localhost:11434/api/generate

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Semantic Search Configuration
SIMILARITY_THRESHOLD=0.70

# Knowledge Base Path
KNOWLEDGE_BASE_PATH=../knowledge_base

# Separate vector database for semantic search (can be the same cache).
# Supported: valkey
VECTOR_ENGINE=valkey
VECTOR_HOST=localhost
VECTOR_PORT=16379

# OpenWeatherMap One Call API 4.0
OPENWEATHERMAP_API_KEY=
OPENWEATHERMAP_TIMEOUT_SECONDS=10
OPENWEATHERMAP_API_HOST=127.0.0.1
OPENWEATHERMAP_API_PORT=5000
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/4.0/onecall

# Cache raw OpenWeatherMap JSON responses in the Valkey JSON-enabled bundle.
OPENWEATHERMAP_CACHE_ENABLED=true
OPENWEATHERMAP_CACHE_HOST=localhost
OPENWEATHERMAP_CACHE_PORT=16379
OPENWEATHERMAP_CACHE_DB=0
OPENWEATHERMAP_CACHE_TTL_SECONDS=600
# Destructive cache clearing is disabled unless explicitly enabled.
OPENWEATHERMAP_CACHE_ALLOW_CLEAR=false

# Cache worldwide OpenWeatherMap city geocoding separately from weather data.
OPENWEATHERMAP_GEOCODING_BASE_URL=https://api.openweathermap.org/geo/1.0/direct
OPENWEATHERMAP_GEOCODING_CACHE_ENABLED=true
OPENWEATHERMAP_GEOCODING_CACHE_HOST=localhost
OPENWEATHERMAP_GEOCODING_CACHE_PORT=16379
OPENWEATHERMAP_GEOCODING_CACHE_DB=0
OPENWEATHERMAP_GEOCODING_CACHE_TTL_SECONDS=86400

# GenAI interpreted prose, exact prompt, and semantic vector cache
GENAI_WEATHER_API_HOST=127.0.0.1
GENAI_WEATHER_API_PORT=5001
GENAI_WEATHER_CACHE_ENABLED=true
GENAI_WEATHER_CACHE_HOST=localhost
GENAI_WEATHER_CACHE_PORT=16379
GENAI_WEATHER_CACHE_DB=0
GENAI_WEATHER_CACHE_TTL_SECONDS=900
GENAI_WEATHER_SIMILARITY_THRESHOLD=0.90
# MMR favors relevance while diversifying the qualified semantic shortlist.
GENAI_WEATHER_MMR_LAMBDA=0.85
GENAI_WEATHER_MMR_TOP_N=5
GENAI_WEATHER_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Destructive cache clearing is disabled unless explicitly enabled.
GENAI_WEATHER_CACHE_ALLOW_CLEAR=false
FLASK_DEBUG=false
