COMPOSE_PROJECT_NAME=valkey-data-structures-lab
VALKEY_MODE=standalone
VALKEY_NODES=
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6381
VALKEY_ADMIN_PORT=8082
VALKEY_USERNAME=default
# Generate the private .env with: uv run --locked python setup_env.py
VALKEY_PASSWORD=
VALKEY_DATABASE=0
VALKEY_REQUEST_TIMEOUT_MS=5000
VALKEY_CONNECTION_TIMEOUT_MS=3000
VALKEY_CLIENT_NAME=valkey-data-structures-workshop

# TLS for Valkey data nodes. Certificate paths are relative to the selected .env.
VALKEY_TLS=false
VALKEY_TLS_CA_CERT=
VALKEY_TLS_CLIENT_CERT=
VALKEY_TLS_CLIENT_KEY=

# Sentinel discovery has independent credentials and certificate settings.
VALKEY_SENTINEL_NODES=
VALKEY_SENTINEL_SERVICE=
VALKEY_SENTINEL_USERNAME=default
VALKEY_SENTINEL_PASSWORD=
# If omitted, VALKEY_SENTINEL_TLS follows VALKEY_TLS.
# VALKEY_SENTINEL_TLS=false
VALKEY_SENTINEL_TLS_CA_CERT=
VALKEY_SENTINEL_TLS_CLIENT_CERT=
VALKEY_SENTINEL_TLS_CLIENT_KEY=
VALKEY_SENTINEL_REFRESH_MS=1000

VALKEY_KEY_PREFIX=ds
